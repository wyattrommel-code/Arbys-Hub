# Copy to .env.local for local dev and set the same in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PIN login session signing (generate a random 32+ char string)
SESSION_SECRET=

# Supabase Dashboard → Project Settings → API → service_role (secret key)
SUPABASE_SERVICE_ROLE_KEY=

# PAR POS: server-only. Replace these in Vercel Settings > Environment Variables, then redeploy.
BRINK_ENVIRONMENT=sandbox
BRINK_API_HOST=api-apiint.brinkpos.net
BRINK_ACCESS_TOKEN=
BRINK_LOCATION_TOKEN=
BRINK_LOCATION_LABEL=API Lab-01
BRINK_SYNC_ENABLED=false
# Explicit opt-in for production only. Replaces hourly_sales; never publishes sandbox sales.
BRINK_PUBLISH_HOURLY_SALES=false
# Random secret of at least 32 characters. Used only by the scheduled sync.
CRON_SECRET=
